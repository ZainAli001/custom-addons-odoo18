<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_hr_employee_code" model="ir.sequence">
        <field name="name">Employee Code</field>
        <field name="code">hr.employee.code</field>
        <field name="prefix">EMP-%(range_y)s</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">standard</field>
    </record>

    <record id="mgmt_level_1" model="hr.management.level">
        <field name="name">Level 1</field>
        <field name="sequence">10</field>
    </record>
    <record id="mgmt_level_2" model="hr.management.level">
        <field name="name">Level 2</field>
        <field name="sequence">20</field>
    </record>
    <record id="mgmt_level_3" model="hr.management.level">
        <field name="name">Level 3</field>
        <field name="sequence">30</field>
    </record>
    <record id="mgmt_level_4" model="hr.management.level">
        <field name="name">Level 4</field>
        <field name="sequence">40</field>
    </record>

    <record id="grade_g05" model="hr.grade">
        <field name="name">G-05</field>
        <field name="sequence">10</field>
    </record>
    <record id="grade_g06" model="hr.grade">
        <field name="name">G-06</field>
        <field name="sequence">20</field>
    </record>
    <record id="grade_g07" model="hr.grade">
        <field name="name">G-07</field>
        <field name="sequence">30</field>
    </record>
    <record id="grade_g08" model="hr.grade">
        <field name="name">G-08</field>
        <field name="sequence">40</field>
    </record>

</odoo>
