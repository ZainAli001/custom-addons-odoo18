                <div class="row g-4 mb-4">

    <!-- Total Employees -->
                    <div class="col">
        <div class="card border-0 h-100"
             style="
                border-radius:18px;
                background:linear-gradient(145deg,#fff4df,#f9d99a);
                box-shadow:8px 8px 18px rgba(180,130,50,0.18),
                           -5px -5px 12px rgba(255,255,255,0.9);
                transition:all 0.25s ease;
             ">

            <div class="card-body text-center position-relative overflow-hidden p-4">

                <div style="
                    position:absolute;
                    top:-35px;
                    right:-35px;
                    width:100px;
                    height:100px;
                    border-radius:50%;
                    background:rgba(255,255,255,0.35);
                "></div>

                <div class="mb-2 mx-auto"
                     style="
                        width:45px;
                        height:45px;
                        border-radius:14px;
                        display:flex;
                        align-items:center;
                        justify-content:center;
                        background:rgba(255,255,255,0.65);
                        box-shadow:inset 2px 2px 5px rgba(180,130,50,0.15),
                                   3px 3px 8px rgba(180,130,50,0.12);
                     ">
                    <i class="fa fa-users"
                       style="font-size:20px;color:#b7791f;"></i>
                </div>

                <h6 class="mb-2 fw-semibold"
                    style="color:#8a5a12;">
                    Total Employees
                </h6>

                <h2 class="fw-bold mb-0"
                    style="color:#6b450d;">
                    <t t-esc="state.totalEmployees"/>
                </h2>

            </div>
        </div>
    </div>


