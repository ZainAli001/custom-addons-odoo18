<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_room" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.room</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="room_management_setting" string="Room Management"
                         help="Enable room selection on POS orders">
                    <field name="pos_module_room_management"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>