<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= LIST VIEW ================= -->

    <record id="hotel_amenity_list_view" model="ir.ui.view">
        <field name="name">hotel.amenity.list</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <list string="Room Amenities">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->

    <record id="hotel_amenity_form_view" model="ir.ui.view">
        <field name="name">hotel.amenity.form</field>
        <field name="model">hotel.amenity</field>
        <field name="arch" type="xml">
            <form string="Room Amenity">

                <sheet>

                    <field name="image"
                           widget="image"
                           class="oe_avatar"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="code"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Enter amenity description..."/>
                        </page>

                    </notebook>

                    <chatter/>

                </sheet>

            </form>
        </field>
    </record>

    <!-- ================= ACTION ================= -->

    <record id="hotel_room_amenity_action" model="ir.actions.act_window">
        <field name="name">Room Amenities</field>
        <field name="res_model">hotel.amenity</field>
        <field name="view_mode">list,form</field>
    </record>



</odoo>