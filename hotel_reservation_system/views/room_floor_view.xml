<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ================= LIST VIEW ================= -->

    <record id="hotel_floor_list_view" model="ir.ui.view">
        <field name="name">hotel.floor.list</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">
            <list string="Hotel Floors">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ================= FORM VIEW ================= -->

    <record id="hotel_floor_form_view" model="ir.ui.view">
        <field name="name">hotel.floor.form</field>
        <field name="model">hotel.floor</field>
        <field name="arch" type="xml">

            <form string="Hotel Floor">

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="code"/>
                        </group>

                        <group>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"
                                   nolabel="1"
                                   placeholder="Enter floor description..."/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <!-- ================= ACTION ================= -->

    <record id="hotel_floor_action" model="ir.actions.act_window">
        <field name="name">Hotel Floors</field>
        <field name="res_model">hotel.floor</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>