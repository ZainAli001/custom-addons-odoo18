<?xml version="1.0" encoding="UTF-8" ?>

<templates xml:space="preserve">

<t t-name="pos_delete_orderline.ListView">

    <div class="container mt-4">

        <!-- ================= TOP BAR (SEARCH + FILTER) ================= -->
        <div class="row mb-4">
            <div class="col-8">
                <input type="text"
                       class="form-control shadow-sm"
                       placeholder="Search POS Orders..."
                       t-model="state.search"/>
            </div>

            <div class="col-4">
                <select class="form-select shadow-sm" t-model="state.filter">
                    <option value="all">All Orders</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                </select>
            </div>
        </div>

        <!-- ================= KPI CARDS ================= -->
        <div class="row g-3">

            <!-- Total Orders -->
            <div class="col-md-3">
                <div class="card text-white bg-primary shadow-lg border-0 rounded-3">
                    <div class="card-body text-center py-4">
                        <h6>Total Orders</h6>
                        <h2 class="fw-bold">
                            <t t-esc="state.records.length"/>
                        </h2>
                    </div>
                </div>
            </div>

            <!-- Revenue -->
            <div class="col-md-3">
                <div class="card text-white bg-success shadow-lg border-0 rounded-3">
                    <div class="card-body text-center py-4">
                        <h6>Total Revenue</h6>
                        <h2 class="fw-bold">
                            <t t-esc="totalRevenue"/>
                        </h2>
                    </div>
                </div>
            </div>

            <!-- POS Products -->
            <div class="col-md-3">
                <div class="card text-white bg-warning shadow-lg border-0 rounded-3">
                    <div class="card-body text-center py-4">
                        <h6>POS Products</h6>
                        <h2 class="fw-bold">
                            <t t-esc="state.posProductCount"/>
                        </h2>
                    </div>
                </div>
            </div>

            <!-- POS Config -->
            <div class="col-md-3">
                <div class="card text-white bg-danger shadow-lg border-0 rounded-3">
                    <div class="card-body text-center py-4">
                        <h6>POS Config</h6>
                        <h2 class="fw-bold">
                            <t t-esc="state.posConfigCount"/>
                        </h2>
                    </div>
                </div>
            </div>

        </div>

        <!-- ================= OPTIONAL TABLE AREA ================= -->
        <div class="mt-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white">
                    Recent POS Orders
                </div>

                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="state.records" t-as="record" t-key="record.id">
                                <tr>
                                    <td>
                                        <t t-esc="record.pos_reference"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="record.amount_total"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</t>
</templates>
